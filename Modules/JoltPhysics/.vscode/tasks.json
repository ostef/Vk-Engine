{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Bindings",
            "type": "shell",
            "command": "jai",
            "args": ["generate.jai", "-", "combined_shared_libs"],
            "group": {
                "kind": "build",
                "isDefault": false
            }
        },
        {
            "label": "Build Hello World",
            "type": "shell",
            "command": "jai",
            "args": ["Examples/hello_world.jai"],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
